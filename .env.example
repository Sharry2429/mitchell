# Mitchell Environment Configuration Example
# Copy this file to .env and adjust the values as needed.

# Application Settings
MITCHELL_APP_NAME=mitchell
MITCHELL_DEBUG=false
MITCHELL_LOG_LEVEL=INFO

# Storage & Paths
MITCHELL_DATA_DIR=data
MITCHELL_EVENT_LOG_PATH=data/events.jsonl

# Browser Pillar Configuration
MITCHELL_BROWSER_HEADLESS=true
MITCHELL_BROWSER_USER_DATA_DIR=data/browser_profiles

# Electron Orb WebSocket Bridge
MITCHELL_ORB_HOST=127.0.0.1
MITCHELL_ORB_PORT=8765
